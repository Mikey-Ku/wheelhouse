# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Do not commit it and do not paste its contents anywhere.
#
# From Supabase: Connect -> Session pooler. It gives you one URI like
#   postgresql://postgres.abcdefghijklm:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Split it into the three values below.

# Everything from the @ onward, with jdbc:postgresql:// in front:
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres

# The part between :// and the first colon:
SPRING_DATASOURCE_USERNAME=postgres.yourprojectref

# The database password you saved when you created the project:
SPRING_DATASOURCE_PASSWORD=
